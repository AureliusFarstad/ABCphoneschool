{
  "name": "refugeeliteracyproject",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 expo start --dev-client",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 pnpm expo prebuild",
    "android": "cross-env EXPO_NO_DOTENV=1 npx expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 npx expo run:ios",
    "doctor": "npx expo-doctor@latest",
    "start:preview": "cross-env APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env APP_ENV=preview pnpm run prebuild",
    "android:preview": "cross-env APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env APP_ENV=preview pnpm run ios",
    "start:production": "cross-env APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env APP_ENV=production pnpm run prebuild",
    "android:production": "cross-env APP_ENV=production pnpm run android",
    "ios:production": "cross-env APP_ENV=production pnpm run ios",
    "build:development:ios": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform ios",
    "build:development:android": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform android ",
    "build:preview:ios": "cross-env APP_ENV=preview EXPO_NO_DOTENV=1 eas build --profile preview --platform ios",
    "build:preview:android": "cross-env APP_ENV=preview EXPO_NO_DOTENV=1 eas build --profile preview --platform android",
    "build:production:ios": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform ios",
    "build:production:android": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform android ",
    "app-release": "node scripts/release-bump.js",
    "release:init": "pnpm exec expo-release-it init",
    "release:bump": "node scripts/release-bump.js patch",
    "release:bump:minor": "node scripts/release-bump.js minor",
    "release:bump:major": "node scripts/release-bump.js major",
    "release:build:ios": "pnpm exec expo-release-it build --platform ios",
    "release:build:android:aab": "pnpm exec expo-release-it build --platform android --androidOutput aab",
    "release:build:android:apk": "pnpm exec expo-release-it build --platform android --androidOutput apk",
    "release:upload:ios": "pnpm exec expo-release-it upload --platform ios",
    "release:upload:android": "pnpm exec expo-release-it upload --platform android",
    "release:upload:ios:meta": "pnpm exec expo-release-it upload --platform ios --uploadMetadata --uploadScreenshot",
    "release:upload:android:meta": "pnpm exec expo-release-it upload --platform android --uploadMetadata --uploadScreenshot",
    "release:submit:ios": "pnpm exec expo-release-it submit --platform ios",
    "release:submit:android": "pnpm exec expo-release-it submit --platform android",
    "release:pull:ios": "pnpm exec expo-release-it pull --platform ios",
    "release:pull:android": "pnpm exec expo-release-it pull --platform android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc  --noemit",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json  ",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test": "echo \"No tests specified\""
  },
  "dependencies": {
    "@expo-google-fonts/dongle": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/neucha": "^0.2.3",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@radix-ui/react-compose-refs": "^1.0.1",
    "@react-navigation/native": "^7.5.1",
    "@shopify/react-native-skia": "2.6.2",
    "@svgator/react-native": "^2.0.1",
    "app-icon-badge": "^0.0.15",
    "clsx": "^2.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "expo": "~56.0.24",
    "expo-asset": "~56.0.25",
    "expo-audio": "~56.0.13",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "^56.0.27",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-font": "^56.0.7",
    "expo-image": "~56.0.13",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.19",
    "expo-localization": "^56.0.6",
    "expo-media-library": "~56.0.11",
    "expo-router": "~56.2.22",
    "expo-splash-screen": "^56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "moti": "^0.30.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-heroicons": "^3.2.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-modal": "^13.0.1",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "rn-super-drag-drop": "^1.0.0",
    "tailwind-merge": "^2.2.1",
    "tailwind-variants": "^0.2.0",
    "tailwindcss": "^3.3.2",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-i18n-json": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-tailwindcss": "^3.15.2",
    "eslint-plugin-unicorn": "^46.0.1",
    "eslint-plugin-unused-imports": "^2.0.0",
    "expo-release-it": "^0.6.5",
    "husky": "^9.0.1",
    "lint-staged": "^13.3.0",
    "metro-react-native-babel-transformer": "^0.77.0",
    "prettier": "^3.3.3",
    "react-native-svg-transformer": "^1.5.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@8.15.1"
}
